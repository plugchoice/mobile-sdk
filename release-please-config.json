{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": false,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "plugchoice-mobile-sdk",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "react-native/package.json",
          "jsonpath": "$.version"
        },
        "react-native/android/build.gradle.kts",
        "android/plugchoice/build.gradle.kts",
        "android/example/build.gradle.kts",
        "android/plugchoice/src/main/java/com/plugchoice/Plugchoice.kt",
        "ios/Sources/PlugchoiceSDK/Plugchoice.swift"
      ]
    }
  }
}
